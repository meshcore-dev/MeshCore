{
  "build": {
    "arduino": {
      "variant_h": "variant_generic.h"
    },
    "core": "stm32",
    "cpu": "cortex-m4",
    "extra_flags": "-DSTM32WL -DSTM32WLxx -DSTM32WL55xx",
    "f_cpu": "48000000L",
    "framework_extra_flags": {
      "arduino": "-DUSE_CM4_STARTUP_FILE -DARDUINO_GENERIC_WL55CCUX"
    },
    "mcu": "stm32wl55ccu6",
    "product_line": "STM32WL55xx",
    "variant": "STM32WLxx/WL54CCU_WL55CCU_WLE4C(8-B-C)U_WLE5C(8-B-C)U"
  },
  "debug": {
    "jlink_device": "STM32WL55CC",
    "openocd_target": "stm32wlx",
    "svd_path": "STM32WL5x_CM4.svd"
  },
  "frameworks": ["arduino"],
  "name": "LilyGO T3 STM32 V1.0 (STM32WL55CCU6)",
  "upload": {
    "maximum_ram_size": 65536,
    "maximum_size": 262144,
    "protocol": "serial",
    "protocols": ["serial", "stlink", "jlink"]
  },
  "url": "https://github.com/Xinyuan-LilyGO/T3-STM32",
  "vendor": "LilyGO"
}
